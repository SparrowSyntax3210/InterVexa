<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Interview Report</title>

  <style>
    body {
  margin: 0;
  font-family: 'Segoe UI', sans-serif;
  background: #0a192f;
  color: #e6f1ff;
}

/* Layout */
.container {
  max-width: 1000px;
  margin: 60px auto;
  padding: 30px;
}

h1 {
  text-align: center;
  color: #64ffda;
  margin-bottom: 50px;
  letter-spacing: 1px;
}

/* 🎯 Score Section */
.score-container {
  display: flex;
  justify-content: center;
  margin-bottom: 60px;
}

.circle {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle-inner {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background: #0a192f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: bold;
  color: #64ffda;
  box-shadow: 0 0 20px rgba(100,255,218,0.2);
}

/* 📝 Answers Section */
.answers {
  display: flex;
  flex-direction: column;
  gap: 30px;
}

/* Card */
.card {
  background: #112240;
  padding: 25px 28px;
  border-radius: 12px;
  border-left: 5px solid #64ffda;
  transition: all 0.3s ease;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.5);
}

/* Question */
.question {
  font-size: 18px;
  font-weight: 600;
  color: #ccd6f6;
  margin-bottom: 15px;
}

/* Answer */
.answer {
  font-size: 15px;
  color: #8892b0;
  margin-bottom: 18px;
  line-height: 1.6;
}

/* Feedback Box */
.feedback {
  background: rgba(100,255,218,0.05);
  padding: 15px;
  border-radius: 8px;
  border-left: 3px solid #64ffda;
  line-height: 1.7;
}

/* Labels */
.feedback strong {
  color: #64ffda;
}

/* 📊 Score Badge */
.score-badge {
  display: inline-block;
  padding: 5px 10px;
  background: #64ffda;
  color: #0a192f;
  border-radius: 6px;
  font-weight: bold;
  margin-bottom: 10px;
}

/* Button */
.download-btn {
  display: block;
  margin: 60px auto 20px;
  padding: 14px 30px;
  background: #64ffda;
  color: #0a192f;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  transition: 0.3s;
}

.download-btn:hover {
  background: #52e0c4;
  transform: scale(1.05);
}
  </style>
</head>

<body>

  <div class="container">

    <h1>📊 Interview Report</h1>

    <!-- 🎯 Confidence Circle -->
    <div class="score-container">
      <div class="circle" id="circle">
        <div class="circle-inner">
          <%= confidence %>%
        </div>
      </div>
    </div>

    <!-- 📝 Answers -->
    <div class="answers">

      <% if (answers.length === 0) { %>
        <p>No answers found</p>
      <% } %>

      <% answers.forEach((item, index) => { %>
        <div class="card">

          <div class="question">
            Q<%= index + 1 %>: <%= item.question %>
          </div>

          <div class="answer">
            <strong>Answer:</strong> <%= item.answer %>
          </div>

          <div class="feedback">
  💡 <strong>Score:</strong> <%= item.feedback?.score ?? "N/A" %><br>

  <strong>Strengths:</strong> 
  <%= item.feedback?.strengths ?? "No data" %><br>

  <strong>Improvements:</strong> 
  <%= item.feedback?.improvements ?? "No data" %>
</div>

        </div>
      <% }) %>

    </div>

    <!-- 📥 Download -->
    <a href="/download-pdf">
      <button class="download-btn">⬇ Download PDF</button>
    </a>

  </div>

  <!-- 🔵 Circle Script -->
  <script>
    const confidence = <%= confidence %>;
    const degree = confidence * 3.6;

    document.getElementById("circle").style.background =
      `conic-gradient(#64ffda ${degree}deg, #112240 0deg)`;
  </script>

</body>
</html>